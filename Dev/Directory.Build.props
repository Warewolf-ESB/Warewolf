<Project>
  <PropertyGroup>
    <!-- Fix VBCSCompiler lock issues on build agents -->
    <UseSharedCompilation>false</UseSharedCompilation>
    
    <!-- Fix parallel build reference assembly locks -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TrackFileAccess>false</TrackFileAccess>

    <!-- Fix MSBuild treating AnyCPU and Any CPU as separate builds concurrently -->
    <Platform Condition="'$(Platform)' == 'AnyCPU'">Any CPU</Platform>

    <!-- Fix parallel build missing g.cs and XAML compilation issues in wpftmp projects -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <GenerateTemporaryTargetAssemblyDebuggingInformation>false</GenerateTemporaryTargetAssemblyDebuggingInformation>
    
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <!-- Pin Google.Protobuf to 3.25.2 solution-wide.
       MySql.Data 8.4.0 brings in Google.Protobuf 3.25.1 as a transitive dependency.
       When all projects share a flat OutDir the 3.25.1 DLL from MySql.Data consumers
       overwrites the 3.25.2 DLL that Warewolf.Execution.Lightweight requires, causing the
       dotnet-isolated Azure Functions worker to crash with a FileNotFoundException on startup
       (strong-named assembly version 3.25.2.0 is not found because only 3.25.1.0 is present).
       Setting the minimum version here forces every project's NuGet resolution to 3.25.2. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.25.2" />
  </ItemGroup>

  <!-- Pin System.Text.Json to 10.0.3 solution-wide.
       Warewolf.Execution.Lightweight (and its EngineJobProcessor/Tests/Integration.Tests siblings)
       pull in Azure.Core 1.52.0 via the Azure Functions worker SDK, which requires
       System.Text.Json >= 10.0.3 for net8.0. Most other projects only need an older floor
       (commonly via Microsoft.PowerFx.Core at 4.7.2, or plain net8.0 defaults at 8.0.x). When all
       projects share a flat OutDir (ServerTests.sln publish) whichever project's copy is written
       last wins, so an older DLL can silently overwrite the 10.0.3 copy Lightweight requires,
       causing the dotnet-isolated Azure Functions worker to crash with a FileNotFoundException on
       startup (assembly version 10.0.0.0 not found). Setting the minimum version here forces every
       project's NuGet resolution to 10.0.3. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
  </ItemGroup>

  <!-- Pin System.Security.Cryptography.Xml to 8.0.4 solution-wide.
       Microsoft.Windows.Compatibility 8.0.27 and Microsoft.Exchange.WebServices.NETStandard 1.1.3
       pull in System.Security.Cryptography.Xml 8.0.3 transitively, which is affected by five HIGH
       severity denial-of-service advisories (GHSA-g8r8-53c2-pm3f, GHSA-8q5v-6pqq-x66h,
       GHSA-cvvh-rhrc-wg4q, GHSA-23rf-6693-g89p, GHSA-mmjf-rqrv-855v) in EncryptedXml. All are fixed
       in 8.0.4 for .NET 8. Setting the minimum version here forces every project's NuGet resolution
       to 8.0.4 so the "Packages Vulnerability Test" security gate (Run-SecurityGates.ps1) passes. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>

  <!-- Add TRX report support for projects using Microsoft.Testing.Platform (EnableMSTestRunner=true).
       MSTest 3.x with EnableMSTestRunner generates a standalone MTP executable whose report-trx
       flag requires the Microsoft.Testing.Extensions.TrxReport package; it is not pulled in
       automatically by MSTest.TestAdapter. Without it the runner rejects the report-trx flag
       and the test job fails. -->
  <ItemGroup Condition="'$(EnableMSTestRunner)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.5.3" />
  </ItemGroup>

  <!-- Copy the repo-root TestRun.ps1 next to every test/spec assembly so the consolidated
       test runner can be invoked from the project's bin directory (matches the layout the
       pipeline and Run-Coverage.ps1 expect when iterating per-project output folders). -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('.Specs'))">
    <None Include="$(MSBuildThisFileDirectory)..\TestRun.ps1" Link="TestRun.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Prevent parallel build of the temporary WPF projects to avoid file locks and isolate their output paths -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <BuildInParallel>false</BuildInParallel>
    <OutDir>bin\wpftmp\</OutDir>
    <PublishDir>bin\wpftmp\publish\</PublishDir>
    <BaseIntermediateOutputPath>obj\wpftmp\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\wpftmp\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Fix for WPF temporary assembly failing to find .g.cs files due to parallel generation -->
  <Target Name="RemoveWpfTempProjectCompileItems" BeforeTargets="CoreCompile" Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <Compile Remove="**\*.g.cs" />
      <Compile Remove="**\*.g.i.cs" />
    </ItemGroup>
  </Target>
</Project>