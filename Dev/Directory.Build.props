<Project>
  <PropertyGroup>
    <!-- Fix VBCSCompiler lock issues on build agents -->
    <UseSharedCompilation>false</UseSharedCompilation>
    
    <!-- Fix parallel build reference assembly locks -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TrackFileAccess>false</TrackFileAccess>

    <!-- Fix MSBuild treating AnyCPU and Any CPU as separate builds concurrently -->
    <Platform Condition="'$(Platform)' == 'AnyCPU'">Any CPU</Platform>

    <!-- Fix parallel build missing g.cs and XAML compilation issues in wpftmp projects -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <GenerateTemporaryTargetAssemblyDebuggingInformation>false</GenerateTemporaryTargetAssemblyDebuggingInformation>
  </PropertyGroup>

  <!-- Prevent parallel build of the temporary WPF projects to avoid file locks -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>
</Project>