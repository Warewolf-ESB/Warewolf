<UserControl x:Class="Dev2.Settings.Chatbot.ChatbotView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:chatbot="clr-namespace:Dev2.Settings.Chatbot"
xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
xmlns:core="clr-namespace:Warewolf.Studio.Core;assembly=Warewolf.Studio.Core"
xmlns:customControls="clr-namespace:Dev2.CustomControls;assembly=Dev2.CustomControls"
d:DesignHeight="300"
d:DesignWidth="800"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance chatbot:IChatbotSettings}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Warewolf.Studio.Themes.Luna;component/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Warewolf Studio;component/Resources/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <chatbot:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource ElementBorderTop}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Background="{StaticResource WareWolfMenuBrush}"
                                HorizontalAlignment="Stretch">
                        <TextBlock Margin="5" Style="{StaticResource SourceHeader}">Chatbot Configuration</TextBlock>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="{StaticResource ControlBorderTop}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Chatbot Source" />
                        <ComboBox x:Name="ChatbotSourcesComboBox"
                                  Grid.Column="1"
                                  Grid.Row="0"
                                  DisplayMemberPath="ResourceName"
                                  SelectedItem="{Binding SelectedChatbotSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Select a chatbot source to use for AI conversations"
                                  ItemsSource="{Binding ChatbotSources}">
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="Select the chatbot source that contains your API endpoint and key configuration."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Grid.Row="0"
                                Content="New"
                                Command="{Binding NewChatbotSourceCommand}"
                                Margin="5,0,0,0"
                                MinWidth="60"
                                ToolTip="Create a new chatbot source">
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="Click to create a new chatbot source with API configuration."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </Button>

                        <Button Grid.Column="3"
                                Grid.Row="0"
                                Content="Edit"
                                Command="{Binding EditChatbotSourceCommand}"
                                Margin="5,0,0,0"
                                MinWidth="60"
                                ToolTip="Edit the selected chatbot source">
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="Click to edit the selected chatbot source configuration."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </Button>

                        <!-- Model Selection Row -->
                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="AI Model"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedChatbotSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFetchingModels}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox x:Name="ModelsComboBox"
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="3"
                                  Margin="0,10,0,0"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AvailableModels}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedChatbotSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFetchingModels}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Tooltip}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="Select the AI model to use for chatbot responses. Different models have different capabilities and costs."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </ComboBox>

                        <!-- Loading Spinner -->
                        <customControls:CircularProgressBar Grid.Column="1" 
                                                            Grid.Row="2" 
                                                            Grid.ColumnSpan="3"
                                                            Width="30"
                                                            Height="30"
                                                            Margin="0,5,0,0"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding IsFetchingModels, Converter={StaticResource BoolToVisibilityConverterPositive}}"/>
                        
                        <!-- System Prompt Options Section -->
                        <TextBlock Grid.Column="0"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="4"
                                   Text="System Prompt Options"
                                   FontWeight="Bold"
                                   Margin="0,20,0,10"/>

                        <CheckBox Grid.Column="0"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="4"
                                  Content="Include System Log"
                                  IsChecked="{Binding IncludeSystemLog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Include recent system log entries in the chatbot context"
                                  Margin="0,5,0,5">
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="When enabled, the chatbot can analyze recent system log entries to help debug issues."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </CheckBox>

                        <!-- Number of Log Lines -->
                        <StackPanel Grid.Column="0"
                                    Grid.Row="4"
                                    Grid.ColumnSpan="4"
                                    Orientation="Horizontal"
                                    Margin="20,5,0,5"
                                    IsEnabled="{Binding IncludeSystemLog}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IncludeSystemLog}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Number of Log Lines:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBox Text="{Binding NumberOfLogLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     VerticalAlignment="Center"
                                     ToolTip="Number of log lines to include in the system prompt (default: 1000)">
                                <i:Interaction.Behaviors>
                                    <core:HelpSetter
                                        Text="Set the number of recent log lines to include in the chatbot context. Higher values provide more context but use more tokens."
                                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </StackPanel>

                        <CheckBox Grid.Column="0"
                                  Grid.Row="5"
                                  Grid.ColumnSpan="4"
                                  Content="Include Resources XAML"
                                  IsChecked="{Binding IncludeResourcesXaml, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Include workflow XAML definitions in the chatbot context (increases token usage)"
                                  Margin="0,5,0,5">
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="When enabled, the chatbot can analyze workflow XAML to understand activities and data flow. This uses more tokens."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </CheckBox>

                        <CheckBox Grid.Column="0"
                                  Grid.Row="6"
                                  Grid.ColumnSpan="4"
                                  Content="Include Resources JSON"
                                  IsChecked="{Binding IncludeResourcesJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Include resource metadata (names, types, IDs) in the chatbot context"
                                  Margin="0,5,0,5">
                            <i:Interaction.Behaviors>
                                <core:HelpSetter
                                    Text="When enabled, the chatbot can see the list of available resources and their metadata."
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </i:Interaction.Behaviors>
                        </CheckBox>
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
