#!/usr/bin/env bash
# =============================================================================
# KeyVaultSetup.azcli
# One-time Azure infrastructure setup for Warewolf Execution Lightweight.
#
# Run in: Azure Cloud Shell, WSL, or any bash shell with az CLI installed.
# Prerequisites: az login, Owner or Contributor + User Access Administrator
#               on the target subscription.
#
# What this script does:
#   1. Creates the Azure Key Vault (Standard SKU, soft-delete + purge-protection)
#   2. Enables System-Assigned Managed Identity on the Function App
#   3. Grants "Key Vault Secrets User"    → Function's Managed Identity (read-only)
#   4. Grants "Key Vault Secrets Officer" → Developer's Entra ID account (read+write)
#   5. Prints the Settings/executionengine.settings.json content to stage on the Function
#      App's already-deployed package (WOLF-8516 — Key Vault name/secret are no longer
#      app settings; not applied by this script, see Step 5 below)
#   6. (Optional) Links Application Insights
# =============================================================================

set -euo pipefail

# ── Variables — edit before running ──────────────────────────────────────────
RESOURCE_GROUP="rg-warewolf-prod"
LOCATION="southafricanorth"                          # az account list-locations -o table
VAULT_NAME="WarewolfServer"              # Must be globally unique (3-24 chars)
FUNCTION_APP_NAME="WarewolfServer"
SECRET_NAME="WW-Execution-Engine-Test"

# Get with: az ad signed-in-user show --query id -o tsv
DEVELOPER_OBJECT_ID="aa870f32-59da-47c4-9e7b-635ccd2f9c05" #ashley.lewis

# Optional — set if Application Insights already exists
APPINSIGHTS_NAME=""                        # e.g. "appi-warewolf-prod" or leave empty

# ── Step 1: Create Key Vault ──────────────────────────────────────────────────
echo "[1/6] Creating Key Vault '$VAULT_NAME' in '$RESOURCE_GROUP'..."
az keyvault create \
  --name               "$VAULT_NAME" \
  --resource-group     "$RESOURCE_GROUP" \
  --location           "$LOCATION" \
  --sku                standard \
  --enable-soft-delete true \
  --enable-purge-protection true \
  --retention-days     90
echo "      Done."

# ── Step 2: Enable System-Assigned Managed Identity on the Function App ───────
echo "[2/6] Enabling Managed Identity on Function App '$FUNCTION_APP_NAME'..."
az functionapp identity assign \
  --name           "$FUNCTION_APP_NAME" \
  --resource-group "$RESOURCE_GROUP"
echo "      Done."

# ── Step 3: Retrieve IDs needed for role assignments ──────────────────────────
echo "[3/6] Retrieving principal and resource IDs..."
FUNCTION_PRINCIPAL_ID=$(az functionapp identity show \
  --name           "$FUNCTION_APP_NAME" \
  --resource-group "$RESOURCE_GROUP" \
  --query principalId -o tsv)

VAULT_RESOURCE_ID=$(az keyvault show \
  --name           "$VAULT_NAME" \
  --resource-group "$RESOURCE_GROUP" \
  --query id -o tsv)

echo "      Function Principal ID : $FUNCTION_PRINCIPAL_ID"
echo "      Key Vault Resource ID : $VAULT_RESOURCE_ID"

# ── Step 4: Assign roles ──────────────────────────────────────────────────────
echo "[4/6] Assigning RBAC roles..."

# Function App → "Key Vault Secrets User" (read secrets only)
az role assignment create \
  --role     "Key Vault Secrets User" \
  --assignee "$FUNCTION_PRINCIPAL_ID" \
  --scope    "$VAULT_RESOURCE_ID"
echo "      'Key Vault Secrets User' → Function Managed Identity"

# Developer → "Key Vault Secrets Officer" (read + write secrets)
az role assignment create \
  --role     "Key Vault Secrets Officer" \
  --assignee "$DEVELOPER_OBJECT_ID" \
  --scope    "$VAULT_RESOURCE_ID"
echo "      'Key Vault Secrets Officer' → Developer ($DEVELOPER_OBJECT_ID)"

# ── Step 5: Key Vault topology (WOLF-8516: no longer app settings) ────────────
# AZURE_KEYVAULT_NAME / KEYVAULT_SECRET_NAME are no longer read by the engine at all —
# HostEnvironmentConfig sources Key Vault name/secret SOLELY from the deploy-bundled
# Settings/executionengine.settings.json file (no env-var fallback). This script has no
# local package directory to stage into, so it cannot write that file itself — either:
#   (a) re-run Deploy-WwExecutionEngine.ps1 with -KeyVaultName/-KeyVaultSecretName (it
#       stages the file into the deploy package automatically), or
#   (b) hand-edit Settings/executionengine.settings.json on the already-deployed app via
#       Kudu (https://$FUNCTION_APP_NAME.scm.azurewebsites.net) or an FTP/WebDeploy tool.
echo "[5/6] Key Vault topology (stage this into Settings/executionengine.settings.json):"
echo "{\"keyVaultName\":\"$VAULT_NAME\",\"keyVaultSecretName\":\"$SECRET_NAME\"}"
echo "      Not applied by this script — see the comment above Step 5 for how to apply it."

# ── Step 6: (Optional) Link Application Insights ──────────────────────────────
if [ -n "$APPINSIGHTS_NAME" ]; then
  echo "[6/6] Linking Application Insights '$APPINSIGHTS_NAME'..."
  APPINSIGHTS_CONNSTR=$(az monitor app-insights component show \
    --app            "$APPINSIGHTS_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --query connectionString -o tsv)

  az functionapp config appsettings set \
    --name           "$FUNCTION_APP_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --settings "APPLICATIONINSIGHTS_CONNECTION_STRING=$APPINSIGHTS_CONNSTR"
  echo "      Application Insights linked."
else
  echo "[6/6] Skipping Application Insights (APPINSIGHTS_NAME not set)."
fi

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
echo "═══════════════════════════════════════════════════════"
echo " Infrastructure setup complete."
echo " Key Vault URI   : https://$VAULT_NAME.vault.azure.net/"
echo " Secret name     : $SECRET_NAME"
echo " Function MI PID : $FUNCTION_PRINCIPAL_ID"
echo ""
echo " NEXT STEPS:"
echo "   1. On developer machine, run Encrypt-Config.ps1 to"
echo "      generate the key and encrypt .bite source files."
echo "   2. Deploy the Function App with the encrypted files."
echo "   3. Verify cold-start log shows: Event=ColdStart"
echo "═══════════════════════════════════════════════════════"
