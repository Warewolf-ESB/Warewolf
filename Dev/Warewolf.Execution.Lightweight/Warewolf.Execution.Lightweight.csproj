<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================= -->
  <!-- CORE CONFIGURATION -->
  <!-- ========================================================= -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>

    <RootNamespace>Warewolf.Execution.Lightweight</RootNamespace>
    <AssemblyName>Warewolf.Execution.Lightweight</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- SIZE OPTIMIZATION (CRITICAL FOR AZURE) -->
  <!-- ========================================================= -->
  <PropertyGroup>

    <!-- Prevent 200MB publish -->
    <SelfContained>false</SelfContained>

    <!-- Prevent native EXE host creation -->
    <UseAppHost>false</UseAppHost>

    <!-- NEVER embed runtime -->
    <RuntimeIdentifier></RuntimeIdentifier>

    <!-- Azure already provides runtime -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Reduce dependency duplication -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Reduce globalization payload -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Functions optimization -->
    <_FunctionsSkipCleanOutput>true</_FunctionsSkipCleanOutput>

  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- FASTEST STARTUP SETTINGS -->
  <!-- ========================================================= -->
  <PropertyGroup>

    <!-- Faster CLR warmup -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>

    <!-- Reduce startup IO -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- AZURE FUNCTIONS PACKAGES -->
  <!-- ========================================================= -->
  <ItemGroup>

    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="1.23.0" />

    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.2.0" />

    <!-- Analyzer only (IMPORTANT) -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="1.18.1" OutputItemType="Analyzer" PrivateAssets="all" />

    <!-- Pin to the version already required by Dev2.Activities → Dev2.Runtime.Services -->
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.15.6" />

    <PackageReference Include="Google.Protobuf" Version="3.25.2" />

    <!-- Azure Key Vault + Managed Identity (encryption support) -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- OIDC / JWT validation for Entra Bearer-token authentication -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />

  </ItemGroup>


  <!-- ========================================================= -->
  <!-- WAREWOLF / DEV2 REFERENCES -->
  <!-- ========================================================= -->
  <ItemGroup>

    <!-- Activity + execution engine -->
    <ProjectReference Include="..\Dev2.Activities\Dev2.Activities.csproj" />

    <ProjectReference Include="..\Dev2.Core\Dev2.Core.csproj" />

    <!-- Licensing / Chargebee integration -->
    <ProjectReference Include="..\Warewolf.Licensing\Warewolf.Licensing.csproj" />

  </ItemGroup>


  <!-- ========================================================= -->
  <!-- OPTIONAL CONTENT COPYING -->
  <!-- ========================================================= -->
  
  <ItemGroup>
    <!--
      Local Resources folder: workflow .bite files for development and testing.
      Only included in Debug builds so that the bin/publish output is clean in
      Release — users are expected to supply their own resources before publishing
      to Azure Functions.
      Files from Resources - Release\Resources that are needed for integration
      tests have been copied here and are tracked in source control.
    -->
    <Content Include="Resources\**\*" Condition="Exists('Resources')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Compile Remove="docs\ClientExamples\**" />
    <EmbeddedResource Remove="docs\ClientExamples\**" />
    <None Remove="docs\ClientExamples\**" />

    <!--
      Optional: if a secure.config is present next to the project file it will be
      copied into the output directory and picked up by SecureConfigLoader at
      runtime (both locally and after zip-deploy to Azure Functions).
      DO NOT commit a real secure.config to source control — add it to .gitignore.
    -->
    <Content Include="Deploy-ToAzure.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="StartAsAzureFunction.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Protect-LicenseConfig.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Compile Include="..\AssemblyCommonInfo.cs">
      <Link>Properties\AssemblyCommonInfo.cs</Link>
    </Compile>
    <None Include="docs\ClientExamples\Angular17\src\app\auth\auth.config.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\auth\auth.service.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\client-credentials\client-credentials.component.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\nav\navbar.component.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\shared\error-panel\error-panel.component.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\shared\token-display\token-display.component.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\workflow\workflow.component.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\workflow\workflow.model.ts" />
    <None Include="docs\ClientExamples\Angular17\src\app\workflow\workflow.service.ts" />
    <None Include="docs\ClientExamples\Angular17\src\environments\environment.prod.ts" />
    <None Include="docs\ClientExamples\Angular17\src\environments\environment.ts" />
    <!--<None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>-->
    <None Include="Scripts\Generate-WorkflowIndex.ps1" />
    <None Include="Scripts\Encrypt-Config.ps1" />
    <None Include="Scripts\Get-DropboxTokens.ps1" />
    <None Include="Scripts\KeyVaultSetup.azcli" />
    <None Include="Scripts\authsettingsV2.json" />
    <None Include="Scripts\Setup-EntraAuth.ps1" />
    <None Include="Scripts\Configure-WwExecutionAuth.ps1" />
    <None Include="Scripts\Configure-WwExecutionAuth-Clients.ps1" />
    <None Include="Scripts\Get-WwExecutionToken.ps1" />
    <None Include="Scripts\Example-ClientApps-OrdersSales.ps1" />
    <None Include="docs\README-Encryption.md" />
    <None Include="docs\KeyRotationRunbook.md" />
    <None Include="docs\SecurityChecklist.md" />
    <None Include="docs\README-Authentication.md" />
    <None Include="docs\AzureProvisioning-FunctionApp.md" />
    <None Include="docs\AzureProvisioning-ClientApps.md" />
    <None Include="docs\ClientsExamples.md" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="secure.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Settings\ElasticsearchLoggingSource.bite">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ========================================================= -->
  <!-- WORKFLOW INDEX GENERATION -->
  <!-- Generate workflow-index.json from the Resources directory  -->
  <!-- so ResolveFilePath can do an O(1) lookup with no disk I/O. -->
  <!-- ========================================================= -->
  <Target Name="GenerateWorkflowIndex" AfterTargets="Build">
    <PropertyGroup>
      <!-- Source Resources directory (relative to project) -->
      <_ResourcesSourceDir>$(MSBuildProjectDirectory)\..\Resources - Release\Resources</_ResourcesSourceDir>
      <!-- Index is generated into the source tree so the Content glob picks it up on -->
      <!-- future builds and the normal CopyToOutputDirectory / Publish mechanisms     -->
      <!-- carry it to the output and publish directories automatically.               -->
      <_IndexSourcePath>$(_ResourcesSourceDir)\workflow-index.json</_IndexSourcePath>
      <_ScriptPath>$(MSBuildProjectDirectory)\Scripts\Generate-WorkflowIndex.ps1</_ScriptPath>
    </PropertyGroup>

    <!-- Run the PowerShell script to enumerate resources and emit the index. -->
    <!-- ContinueOnError: if PowerShell is unavailable the build still succeeds -->
    <!-- and ResolveFilePath falls back to its existing disk-based resolution.  -->
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_ScriptPath)&quot; -ResourcesDir &quot;$(_ResourcesSourceDir)&quot; -OutputPath &quot;$(_IndexSourcePath)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />

    <!-- Copy the newly generated index to the output directory immediately so it  -->
    <!-- is present on the very first build (before the Content glob can pick it  -->
    <!-- up on a subsequent build).                                                 -->
    <Copy SourceFiles="$(_IndexSourcePath)" DestinationFiles="$(OutDir)Resources\workflow-index.json" SkipUnchangedFiles="true" ContinueOnError="true" Condition="Exists('$(_IndexSourcePath)')" />
  </Target>
  
  
  <!-- When building via ServerTests.sln, Compile.ps1 sets /property:OutDir=... globally.
       OutDir takes precedence over OutputPath, which causes the WorkerExtensions sub-project
       to write to the flat solution output dir instead of the expected buildout\bin\ path,
       breaking the EnhanceExtensionsMetadata task. Adding OutDir to the remove-list at
       runtime (inside a target) ensures it is stripped before _WorkerExtensionsBuild fires. -->
  <Target Name="_RemoveOutDirFromWorkerExtensionsBuild" BeforeTargets="_WorkerExtensionsBuild">
    <PropertyGroup>
      <_FunctionsExtensionRemoveProps>$(_FunctionsExtensionRemoveProps);OutDir</_FunctionsExtensionRemoveProps>
    </PropertyGroup>
  </Target>

  <!-- Copy workflow .bite files from Resources - Release to the output Resources directory.
       Required so that ApisJsonGenerator finds workflow files during integration tests
       (e.g. Warewolf.Security.Specs) regardless of build configuration. -->
  <Target Name="CopyWorkflowResources" AfterTargets="Build">
    <ItemGroup>
      <_BiteResources Include="$(MSBuildProjectDirectory)\..\Resources - Release\Resources\**\*.bite" />
    </ItemGroup>
    <Copy SourceFiles="@(_BiteResources)"
          DestinationFolder="$(OutDir)Resources\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

  <Target Condition="'$(TargetFramework)' == 'net8.0'" BeforeTargets="_CheckForTransitiveWindowsDesktopDependencies" Name="_FixStupidSdkError_NETSDK1136">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
    </ItemGroup>
  </Target>
</Project>