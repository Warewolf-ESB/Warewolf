<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================= -->
  <!-- CORE CONFIGURATION -->
  <!-- ========================================================= -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>

    <RootNamespace>Warewolf.Execution.Lightweight</RootNamespace>
    <AssemblyName>Warewolf.Execution.Lightweight</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- SIZE OPTIMIZATION (CRITICAL FOR AZURE) -->
  <!-- ========================================================= -->
  <PropertyGroup>

    <!-- Prevent 200MB publish -->
    <SelfContained>false</SelfContained>

    <!-- Prevent native EXE host creation -->
    <UseAppHost>false</UseAppHost>

    <!-- NEVER embed runtime -->
    <RuntimeIdentifier></RuntimeIdentifier>

    <!-- Azure already provides runtime -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Reduce dependency duplication -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Reduce globalization payload -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Functions optimization -->
    <_FunctionsSkipCleanOutput>true</_FunctionsSkipCleanOutput>

  </PropertyGroup>

  <!-- ========================================================= -->
  <!-- PUBLISH GATING -->
  <!-- ========================================================= -->
  <!--
    Skip 'dotnet publish' on Debug builds.

    The hosted CI pipeline publishes ServerTests.sln (which transitively
    includes this project) with the .NET 8.0.421 SDK and `-r win-x64`,
    which triggers an MSB3030 in Microsoft.Azure.Functions.Worker.Sdk 1.18.1
    when it tries to copy obj\Debug\net8.0\win-x64\extensions.json (the
    Worker SDK writes the file to the non-RID-qualified obj path while the
    main publish target looks for it under the RID subfolder).

    Test projects only need this project's BUILD output (referenced via
    ProjectReference and consumed in-process), not its PUBLISH output, so
    skipping the publish step on Debug is safe for the test pipeline.

    Release publishes (the Azure deployment path driven by Deploy-ToAzure.ps1)
    still need to publish, so the gate is scoped to Debug only.
  -->
  <!--
    Scope the publish-skip to the RID-qualified CI scenario only.
    The MSB3030 (extensions.json copied to the non-RID obj path while publish
    looks under the RID subfolder) is only triggered when ServerTests.sln is
    published with `-r win-x64`. The Docker / local debug publish path
    (engine\run.ps1) uses `dotnet publish -c Debug` with NO RuntimeIdentifier,
    so it must remain publishable — otherwise the Worker SDK post-publish target
    never runs and the `.azurefunctions` folder is missing from the output.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' AND '$(RuntimeIdentifier)' != ''">
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- FASTEST STARTUP SETTINGS -->
  <!-- ========================================================= -->
  <PropertyGroup>

    <!-- Faster CLR warmup -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>

    <!-- Reduce startup IO -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- AZURE FUNCTIONS PACKAGES -->
  <!-- ========================================================= -->
  <ItemGroup>

    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="1.23.0" />

    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.2.0" />

    <!-- Service Bus trigger for the secure, in-process "Model A" workflow trigger
         (Spec-Secure-ServiceBus-Triggered-Execution.md). Pinned to the same version
         already used by the companion Warewolf.Execution.ServiceBusWorker project. -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.20.0" />

    <!-- Worker SDK for isolated process model - generates .azurefunctions folder -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="1.18.1" />

    <!-- Application Insights for rich telemetry and structured logging -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="1.4.0" />

    <!-- Required for AddApplicationInsightsTelemetryWorkerService() in the isolated
         worker. NOT a transitive dependency of the Functions AI package above, so it
         must be referenced explicitly; without it ConfigureFunctionsApplicationInsights()
         throws "Application Insights SDK has not been added" at startup.
         MUST stay on the 2.x line: Microsoft.Azure.Functions.Worker.ApplicationInsights
         1.4.0 is built against the Application Insights v2 core (Microsoft.ApplicationInsights
         2.x, which is where Microsoft.ApplicationInsights.Extensibility.ITelemetryInitializer
         lives). Using 3.0.0 pulls Microsoft.ApplicationInsights 3.0.0.1 and crashes the worker
         at startup with TypeLoadException: 'Could not load type ... ITelemetryInitializer'. -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.22.0" />

    <!-- Pin to the version already required by Dev2.Activities → Dev2.Runtime.Services -->
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.15.6" />

    <!-- Azure Key Vault + Managed Identity (encryption support) -->
    <PackageReference Include="Azure.Identity" Version="1.20.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- OIDC / JWT validation for Entra Bearer-token authentication -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.17.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />

  </ItemGroup>


  <!-- ========================================================= -->
  <!-- WAREWOLF / DEV2 REFERENCES -->
  <!-- ========================================================= -->
  <ItemGroup>

    <!-- Activity + execution engine -->
    <ProjectReference Include="..\Dev2.Activities\Dev2.Activities.csproj" />

    <ProjectReference Include="..\Dev2.Core\Dev2.Core.csproj" />

    <!-- Diagnostics and logging -->
    <ProjectReference Include="..\Dev2.Diagnostics\Dev2.Diagnostics.csproj" />

    <!-- Licensing / Chargebee integration -->
    <ProjectReference Include="..\Warewolf.Licensing\Warewolf.Licensing.csproj" />

    <!--
      Warewolf.Usage: third-party closed-source assembly (also referenced by
      Dev2.Runtime.Services).  Provides UsageTracker.TrackEvent which writes
      one row per call to the UsageData SQL table — used by the per-execution
      usage emitter (8438).
    -->
    <Reference Include="Warewolf.Usage, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>..\Binaries\Warewolf.Usage.dll</HintPath>
      <Private>true</Private>
    </Reference>

  </ItemGroup>


  <!-- ========================================================= -->
  <!-- OPTIONAL CONTENT COPYING -->
  <!-- ========================================================= -->
  
  <ItemGroup>
    <!--
      Local Resources folder: workflow .bite files for development and testing.
      Only included in Debug builds so that the bin/publish output is clean in
      Release — users are expected to supply their own resources before publishing
      to Azure Functions.
      Files from Resources - Release\Resources that are needed for integration
      tests have been copied here and are tracked in source control.
    -->
    <Content Include="Resources\**\*" Condition="Exists('Resources') AND '$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!--
      Optional: if a secure.config is present next to the project file it will be
      copied into the output directory and picked up by SecureConfigLoader at
      runtime (both locally and after zip-deploy to Azure Functions).
      DO NOT commit a real secure.config to source control — add it to .gitignore.
    -->
    <Content Include="Deploy-ToAzure.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="StartAsAzureFunction.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Protect-LicenseConfig.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Compile Include="..\AssemblyCommonInfo.cs">
      <Link>Properties\AssemblyCommonInfo.cs</Link>
    </Compile>
    <!--<None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>-->
    <None Include="Scripts\Generate-WorkflowIndex.ps1" />
    <None Include="Scripts\Encrypt-Config.ps1" />
    <None Include="Scripts\Get-DropboxTokens.ps1" />
    <None Include="Scripts\KeyVaultSetup.azcli" />
    <None Include="Scripts\authsettingsV2.json" />
    <None Include="Scripts\Setup-EntraAuth.ps1" />
    <None Include="Scripts\Configure-WwExecutionAuth.ps1" />
    <None Include="Scripts\Configure-WwExecutionAuth-Clients.ps1" />
    <None Include="Scripts\Get-WwExecutionToken.ps1" />
    <None Include="Scripts\Example-ClientApps-OrdersSales.ps1" />
    <None Include="docs\README-Encryption.md" />
    <None Include="docs\KeyRotationRunbook.md" />
    <None Include="docs\SecurityChecklist.md" />
    <None Include="docs\README-Authentication.md" />
    <None Include="docs\AzureProvisioning-FunctionApp.md" />
    <None Include="docs\AzureProvisioning-ClientApps.md" />
    <None Include="docs\ClientsExamples.md" />
    <!--
      Skill.md ships INTO the Release publish output (so it travels inside every
      "release" zip and an operator/LLM deploying from the zip has the deploy guide),
      but Deploy-ToAzure.ps1 excludes *.md from the Azure upload so it is never pushed
      to the running Function App.
    -->
    <Content Include="Skill.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <!-- NEVER publish local.settings.json — it may contain development secrets. -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="secure.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Settings\ElasticsearchLoggingSource.bite">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Settings\persistencesettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Settings\persistencesettingsdbsource.bite">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ========================================================= -->
  <!-- WORKFLOW INDEX GENERATION -->
  <!-- Generate workflow-index.json from the Resources directory  -->
  <!-- so ResolveFilePath can do an O(1) lookup with no disk I/O. -->
  <!-- ========================================================= -->
  <Target Name="GenerateWorkflowIndex" AfterTargets="Build">
    <PropertyGroup>
      <!-- Source Resources directory (relative to project) -->
      <_ResourcesSourceDir>$(MSBuildProjectDirectory)\..\Resources - Release\Resources</_ResourcesSourceDir>
      <!-- Index is generated into the source tree so the Content glob picks it up on -->
      <!-- future builds and the normal CopyToOutputDirectory / Publish mechanisms     -->
      <!-- carry it to the output and publish directories automatically.               -->
      <_IndexSourcePath>$(_ResourcesSourceDir)\workflow-index.json</_IndexSourcePath>
      <_ScriptPath>$(MSBuildProjectDirectory)\Scripts\Generate-WorkflowIndex.ps1</_ScriptPath>
    </PropertyGroup>

    <!-- Run the PowerShell script to enumerate resources and emit the index. -->
    <!-- ContinueOnError: if PowerShell is unavailable the build still succeeds -->
    <!-- and ResolveFilePath falls back to its existing disk-based resolution.  -->
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_ScriptPath)&quot; -ResourcesDir &quot;$(_ResourcesSourceDir)&quot; -OutputPath &quot;$(_IndexSourcePath)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />

    <!-- Copy the newly generated index to the output directory immediately so it  -->
    <!-- is present on the very first build (before the Content glob can pick it  -->
    <!-- up on a subsequent build).                                                 -->
    <Copy SourceFiles="$(_IndexSourcePath)" DestinationFiles="$(OutDir)Resources\workflow-index.json" SkipUnchangedFiles="true" ContinueOnError="true" Condition="Exists('$(_IndexSourcePath)')" />
  </Target>
  
  
  <!-- When building via ServerTests.sln, Compile.ps1 sets /property:OutDir=... globally.
       OutDir takes precedence over OutputPath, which causes the WorkerExtensions sub-project
       to write to the flat solution output dir instead of the expected buildout\bin\ path,
       breaking the EnhanceExtensionsMetadata task. Adding OutDir to the remove-list at
       runtime (inside a target) ensures it is stripped before _WorkerExtensionsBuild fires. -->
  <Target Name="_RemoveOutDirFromWorkerExtensionsBuild" BeforeTargets="_WorkerExtensionsBuild">
    <PropertyGroup>
      <_FunctionsExtensionRemoveProps>$(_FunctionsExtensionRemoveProps);OutDir</_FunctionsExtensionRemoveProps>
    </PropertyGroup>
  </Target>

  <Target Condition="'$(TargetFramework)' == 'net8.0'" BeforeTargets="_CheckForTransitiveWindowsDesktopDependencies" Name="_FixStupidSdkError_NETSDK1136">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
    </ItemGroup>
  </Target>
</Project>