FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated8.0-appservice

# curl and procps are needed by the VS remote test/debug agent.
# The appservice base image is minimal so we ensure they are present.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl \
       procps \
    && rm -rf /var/lib/apt/lists/*

# vstest.console.dll (mounted from VS) targets .NET 8. Install the runtime so
# the script can invoke it directly without needing the full SDK.
RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
    | bash -s -- --runtime dotnet --channel 8.0 --install-dir /usr/share/dotnet --no-path

# Install the Visual Studio remote debugger so tests can be stepped through
# in Test Explorer just like local tests.
RUN curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg

# Give the vstest.console handshake more time on slower container starts
ENV VSTEST_CONNECTION_TIMEOUT=300
