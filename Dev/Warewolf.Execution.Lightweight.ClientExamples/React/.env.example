# Warewolf Execution Engine - React client configuration
# -------------------------------------------------------
# Copy this file to `.env.local` (which is git-ignored) and fill in the real
# values for your tenant. Vite only exposes variables prefixed with `VITE_`.
#
#   cp .env.example .env.local      # macOS / Linux
#   Copy-Item .env.example .env.local   # PowerShell
#
# After editing .env.local you must restart `npm run dev` for changes to load.

# Directory (tenant) ID of your Microsoft Entra ID tenant (GUID).
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of THIS SPA's app registration (public client / SPA).
VITE_SPA_CLIENT_ID=11111111-1111-1111-1111-111111111111

# Application (client) ID of the protected API app registration that fronts the
# Warewolf Execution Engine Function App. Used to build the delegated scope
# `api://{resourceAppId}/user_impersonation`.
VITE_RESOURCE_APP_ID=22222222-2222-2222-2222-222222222222

# Base URL of the Warewolf Execution Engine Function App (no trailing slash).
VITE_FUNCTION_APP_URL=https://WWExecutionEngine.azurewebsites.net
