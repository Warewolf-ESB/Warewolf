<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>Warewolf.Execution.AzureFunction.Lightweight</RootNamespace>
    <AssemblyName>Warewolf.Execution.AzureFunction.Lightweight</AssemblyName>
    <EnableDefaultItems>true</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="1.19.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Only two direct project references needed:
        - Dev2.Activities: provides ActivityParser (XAML DynamicActivity ? IDev2Activity chain)
        - Dev2.Core: provides DsfDataObject, ExecutionEnvironmentUtils, IDev2Activity, Dev2XamlLoader

      Everything else flows in transitively:
        Dev2.Activities ? Dev2.Core, Dev2.Data, Dev2.Common, Warewolf.Storage, etc.
        Dev2.Core       ? Dev2.Common, Dev2.Common.Interfaces, Warewolf.Interfaces,
                          Warewolf.Storage, Warewolf.Storage.Interfaces, Dev2.Data, etc.
    -->
    <ProjectReference Include="..\Dev2.Activities\Dev2.Activities.csproj" />
    <ProjectReference Include="..\Dev2.Core\Dev2.Core.csproj" />
  </ItemGroup>
</Project>
