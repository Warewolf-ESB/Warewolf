<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>Warewolf.Execution.AzureFunction.Lightweight</RootNamespace>
    <AssemblyName>Warewolf.Execution.AzureFunction.Lightweight</AssemblyName>
    <EnableDefaultItems>true</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress transitive Windows Desktop refs pulled in by Dev2.Runtime -->
    <_FunctionsSkipCleanOutput>true</_FunctionsSkipCleanOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="1.19.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="1.17.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Only two direct project references needed:
        - Dev2.Activities: provides ActivityParser (XAML DynamicActivity ? IDev2Activity chain)
        - Dev2.Core: provides DsfDataObject, ExecutionEnvironmentUtils, IDev2Activity, Dev2XamlLoader

      Everything else flows in transitively:
        Dev2.Activities ? Dev2.Core, Dev2.Data, Dev2.Common, Warewolf.Storage, etc.
        Dev2.Core       ? Dev2.Common, Dev2.Common.Interfaces, Warewolf.Interfaces,
                          Warewolf.Storage, Warewolf.Storage.Interfaces, Dev2.Data, etc.
    -->
    <ProjectReference Include="..\Dev2.Activities\Dev2.Activities.csproj" />
    <ProjectReference Include="..\Dev2.Core\Dev2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Resources - Release\Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="..\AssemblyCommonInfo.cs" Condition="Exists('..\AssemblyCommonInfo.cs')">
      <Link>Properties\AssemblyCommonInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <Target Condition="'$(TargetFramework)' == 'net8.0'" BeforeTargets="_CheckForTransitiveWindowsDesktopDependencies" Name="_FixStupidSdkError_NETSDK1136">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
    </ItemGroup>
  </Target>
</Project>
