<UserControl x:Class="Warewolf.Studio.Views.ManageChatbotSourceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:languages="clr-namespace:Warewolf.Studio.Resources.Languages;assembly=Warewolf.Studio.Resources"
             xmlns:core="clr-namespace:Warewolf.Studio.Core;assembly=Warewolf.Studio.Core"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             xmlns:views="clr-namespace:Warewolf.Studio.Views"
             xmlns:customControls="clr-namespace:Warewolf.Studio.CustomControls;assembly=Warewolf.Studio.CustomControls"
             xmlns:interfaces="clr-namespace:Dev2.Common.Interfaces;assembly=Dev2.Common.Interfaces"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=interfaces:IManageChatbotSourceViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Warewolf.Studio.Themes.Luna;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="SourceGrid"
          Margin="{StaticResource ElementBorder}"
          FocusManager.FocusedElement="{Binding ElementName=CompletionsEndpointTextBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Background="{StaticResource WareWolfMenuBrush}" HorizontalAlignment="Stretch" Orientation="Horizontal">
            <TextBlock x:Name="HeaderTextBlock" Margin="5" Text="{Binding HeaderText}" Style="{StaticResource SourceHeader}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="{StaticResource ControlBorderTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="{StaticResource ControlBorderTop}"
                       VerticalAlignment="Center"
                       Grid.Column="0"
                       Grid.Row="0"
                       Text="Completions Endpoint"/>
            <TextBox x:Name="CompletionsEndpointTextBox"
                     Margin="{StaticResource ControlBorderTop}"
                     Grid.Column="1"
                     Grid.Row="0"
                     Text="{Binding CompletionsEndpoint, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The API endpoint URL for chat completions (e.g., https://api.openai.com/v1/chat/completions)"
                     Focusable="True"
                     views:FocusExtension.IsFocused="True">
                <i:Interaction.Behaviors>
                    <core:HelpSetter Text="Enter the URL of the chatbot API endpoint for completions." DataContext="{Binding}" />
                </i:Interaction.Behaviors>
            </TextBox>
            <TextBlock VerticalAlignment="Center"
                       Grid.Column="0"
                       Grid.Row="1"
                       Margin="{StaticResource ControlBorderTop}"
                       Text="Models Endpoint"/>
            <TextBox x:Name="ModelsEndpointTextBox"
                     Grid.Column="1"
                     Grid.Row="1"
                     Margin="{StaticResource ControlBorderTop}"
                     Text="{Binding ModelsEndpoint, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The API endpoint URL for models (optional, e.g., https://api.openai.com/v1/models)">
                <i:Interaction.Behaviors>
                    <core:HelpSetter Text="Enter the URL of the chatbot API endpoint for models (optional)." DataContext="{Binding}" />
                </i:Interaction.Behaviors>
            </TextBox>
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Margin="{StaticResource ControlBorderTop}"
                       VerticalAlignment="Center"
                       Text="API Key"/>
            <customControls:PasswordBoxUserControl x:Name="ApiKeyPasswordBox"
                         Grid.Column="1"
                         Grid.Row="2"
                         ToolTip="The API key for authentication with the chatbot service"
                         Margin="{StaticResource ControlBorderTop}"
                         Text="{Binding Path=ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <i:Interaction.Behaviors>
                    <core:HelpSetter Text="Enter the API key for authenticating with the chatbot service." DataContext="{Binding}" />
                </i:Interaction.Behaviors>
            </customControls:PasswordBoxUserControl>
        </Grid>
        <StackPanel Grid.Row="2"
                    Margin="{StaticResource ControlBorderTop}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <fa:ImageAwesome Width="14"
                             Height="14"
                             Foreground="{StaticResource WareWolfOrangeBrush}"
                             Margin="{StaticResource ControlBorderRight}"
                             Visibility="{Binding Path=TestPassed, Converter={StaticResource BoolToVisibilityConverter}}"
                             Icon="Check"
                             HorizontalAlignment="Right" />
            <fa:ImageAwesome Width="14"
                             Height="14"
                             Foreground="{StaticResource WareWolfOrangeBrush}"
                             Margin="{StaticResource ControlBorderRight}"
                             Visibility="{Binding Path=TestFailed, Converter={StaticResource BoolToVisibilityConverter}}"
                             Icon="Ban"
                             HorizontalAlignment="Right" />
            <views:CircularProgressBar Width="14"
                                       Height="14"
                                       Margin="{StaticResource ControlBorderRight}"
                                       Visibility="{Binding Path=Testing, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button x:Name="TestConnectionButton"
                    Margin="{StaticResource ControlBorderRight}"
                    Width="120"
                    Height="30"
                    Command="{Binding TestCommand}"
                    Content="Test Connection"
                    ToolTip="Test the connection to the chatbot service">
                <i:Interaction.Behaviors>
                    <core:HelpSetter Text="Click to test the connection to the chatbot API endpoint." DataContext="{Binding}" />
                </i:Interaction.Behaviors>
            </Button>
            <Button x:Name="CancelButton"
                    Width="120"
                    Height="30"
                    ToolTip="Cancel the connection test"
                    Command="{Binding CancelTestCommand}"
                    Content="Cancel Test">
                <i:Interaction.Behaviors>
                    <core:HelpSetter Text="Click to cancel the connection test." DataContext="{Binding}" />
                </i:Interaction.Behaviors>
            </Button>
        </StackPanel>
        <TextBox TextWrapping="WrapWithOverflow"
                 Grid.Row="3"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"
                 Margin="{StaticResource ControlBorderTop}"
                 x:Name="ErrorTextBlock"
                 Text="{Binding TestMessage}"
                 Style="{StaticResource ErrorMessageTextboxStyle}"
                 Visibility="{Binding Path=TestFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <i:Interaction.Behaviors>
                <customControls:DoubleClickBehavior/>
            </i:Interaction.Behaviors>
        </TextBox>
    </Grid>
</UserControl>
