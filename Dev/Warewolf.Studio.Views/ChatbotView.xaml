<UserControl x:Class="Warewolf.Studio.Views.ChatbotView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:viewModels="clr-namespace:Warewolf.Studio.ViewModels;assembly=Warewolf.Studio.ViewModels"
xmlns:luna="clr-namespace:Warewolf.Studio.Themes.Luna;assembly=Warewolf.Studio.Themes.Luna"
xmlns:views="clr-namespace:Warewolf.Studio.Views"
mc:Ignorable="d"
d:DesignHeight="450" d:DesignWidth="800"
d:DataContext="{d:DesignInstance Type={x:Type viewModels:ChatbotViewModel}}">
<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <luna:SharedResourceDictionary Source="/Warewolf.Studio.Themes.Luna;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Conversation History Toolbar -->
        <Grid Grid.Row="0" Margin="10,5"
              Visibility="{Binding IsChatbotConfigured, Converter={StaticResource BoolToVisibilityConverterPositive}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding SavedConversations}"
                      SelectedItem="{Binding SelectedConversation}"
                      DisplayMemberPath="Title"
                      Height="30"
                      VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="New Chat"
                    Command="{Binding NewConversationCommand}"
                    Margin="5,0,0,0" Width="80" Height="30"/>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- No Configuration Message -->
            <StackPanel Visibility="{Binding ShowConfigurationMessage, Converter={StaticResource BoolToVisibilityConverterPositive}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="20">
                    <Run Text="No Chatbot Source has been configured. " />
                    <Hyperlink Command="{Binding OpenSettingsCommand}"
                               Style="{StaticResource HyperLinkStyle}">
                        <Run Text="Open Settings" />
                    </Hyperlink>
                    <Run Text=" to select a Chatbot Source." />
                </TextBlock>
            </StackPanel>

            <!-- Chat Interface (Messages List) -->
            <ScrollViewer Visibility="{Binding IsChatbotConfigured, Converter={StaticResource BoolToVisibilityConverterPositive}}"
                          VerticalScrollBarVisibility="Auto"
                          Margin="10">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}"
                                       TextWrapping="Wrap"
                                       Margin="5"
                                       Padding="5">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy Message" Click="CopyMessage_Click" Tag="{Binding}"/>
                                        <MenuItem Header="Copy All Messages" Click="CopyAllMessages_Click"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading Spinner -->
            <views:CircularProgressBar Width="50"
                                       Height="50"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverterPositive}}"/>
        </Grid>

        <!-- Input Area - Only visible when configured -->
        <Grid Grid.Row="2"
              Margin="10"
              Visibility="{Binding IsChatbotConfigured, Converter={StaticResource BoolToVisibilityConverterPositive}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                     Padding="5"
                     VerticalContentAlignment="Center"
                     Height="30">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Content="Send"
                    Command="{Binding SendCommand}"
                    Margin="5,0,0,0"
                    Width="80"
                    Height="30"/>
        </Grid>
    </Grid>
</UserControl>
